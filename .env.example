# Supabase public values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional when Supabase Auth has exactly one user. Required if it has more than one.
APP_OWNER_USER_ID=

# Sprint migrations only. Keep these local and never pass them as CLI arguments.
SUPABASE_DB_PASSWORD=

# Preferred: Dashboard > Connect > Session pooler connection string.
SUPABASE_DATABASE_URL=

# Server-side model configuration.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5

# Optional. Usually auto-discovered from PATH or a Windows WinGet installation.
CLAUDE_CLI_PATH=

# Optional local setting defaults.
OBSIDIAN_DEFAULT_VAULT_ID=bible-study-main
OBSIDIAN_DEFAULT_INPUT_FOLDER=
OBSIDIAN_DEFAULT_OUTPUT_FOLDER=

# Optional override for the per-PC config directory.
# Default: %LOCALAPPDATA%\FamilyWorshipSermonAI
APP_LOCAL_CONFIG_DIR=
