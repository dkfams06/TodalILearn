# Supabase public values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Sprint migrations only. Keep these local and never pass them as CLI arguments.
SUPABASE_DB_PASSWORD=

# Preferred: Dashboard > Connect > Session pooler connection string.
SUPABASE_DATABASE_URL=

# Server-side model configuration.
ANTHROPIC_MODEL=claude-opus-4-8

# Optional local setting defaults.
OBSIDIAN_DEFAULT_VAULT_ID=bible-study-main
OBSIDIAN_DEFAULT_INPUT_FOLDER=
OBSIDIAN_DEFAULT_OUTPUT_FOLDER=

